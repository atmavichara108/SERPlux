# .env.sandbox.example — переменные песочницы SERPlux.
# Копировать НЕ нужно: docker-compose.sandbox.yml задаёт всё environment'ом.
# Файл — документация, что песочница не требует секретов.
#
# Все значения безопасные/фейковые, отсутствие реальных ключей — ожидаемо.

SANDBOX_MODE=1
SANDBOX_EXPORT_PATH=/app/data/export.json
SANDBOX_REPORT_PATH=/app/data/report.json
TOPVISOR_API_BASE=http://mock-topvisor:8011/v2/json
LLM_API_BASE=http://mock-llm:8012/v1/chat/completions
WEBHOOK_SECRET=sandbox-secret-not-production
WEBHOOK_PORT=8000
DB_PATH=/app/data/serplux.db
LOG_LEVEL=INFO
