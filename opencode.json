
{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "build",
  "model": "opencode-go/gpt-5.6-luna",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": {
      "*": "deny",
      "/home/rudra/Projects/serp/**": "allow",
      "/home/rudra/Projects/OpenCode-Vault/**": "allow",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "readlink*": "allow",
      "realpath*": "allow",
      "basename*": "allow",
      "dirname*": "allow",
      "which*": "allow",
      "type*": "allow",
      "du -sh*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git tag -l*": "allow",
      "git ls-files*": "allow",
      "git remote -v*": "allow",
      "git describe*": "allow",
      "git symbolic-ref*": "allow",
      "git blame*": "allow",
      "python -m pytest*": "allow",
      "git push*": "ask",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git rebase*": "deny",
      "git branch -D*": "deny",
      "git tag -d*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm *": "ask",
      "rm -rf*": "deny",
      "rm -r*": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "docker*": "deny",
      "systemctl*": "deny",
      "sudo *": "deny"
    },
    "webfetch": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/gpt-5.6-luna",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "task": { "*": "allow" }
      }
    }
  }
}
